{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "com.framelab.app",
  "version": "1.0.0",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "logging": {
    "enabled": true,
    "writeToLogFile": true
  },
  "nativeAllowList": [
    "app.*",
    "os.*",
    "filesystem.*",
    "window.*",
    "debug.*",
    "storage.*",
    "events.*"
  ],
  "modes": {
    "window": {
      "title": "FrameLab · 二维平面框架结构分析器",
      "width": 1440,
      "height": 900,
      "minWidth": 1024,
      "minHeight": 640,
      "center": true,
      "maximize": true,
      "fullScreen": false,
      "alwaysOnTop": false,
      "icon": "/resources/icons/appIcon.png",
      "enableInspector": false,
      "borderless": false,
      "hidden": false,
      "resizable": true,
      "exitProcessOnClose": true,
      "useSavedState": false
    }
  },
  "cli": {
    "binaryName": "FrameLab",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/resources/js/neutralino.js",
    "binaryVersion": "6.9.0",
    "clientVersion": "6.9.0"
  },
  "applicationName": "FrameLab",
  "author": "FrameLab",
  "description": "FrameLab · 二维平面框架结构分析器（Neutralinojs 桌面版，内置求解器离线可用）",
  "copyright": "MIT License"
}
